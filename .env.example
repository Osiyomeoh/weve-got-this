# AWS - the conductor profile has Bedrock access for this project.
AWS_PROFILE=conductor
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# We've Got This
PORT=8787
SIM_PORT=5173
CARECIRCLE_URL=http://localhost:8787/mcp
CARECIRCLE_DB=carecircle.db.json

# Set to deliver notify_member over SNS (else record-only)
CARECIRCLE_SNS_TOPIC=

# Bee (bee.computer). No wearable needed: the Bee iPhone app in Developer Mode, then `bee login`.
# Reads facts and todos; with BEE_MEMBER_ID set, that member's dose reminders also go into
# their Bee as a todo with an alarm, and ticking it done records the dose as their word.
BEE_TOKEN=
BEE_API_BASE=
BEE_MEMBER_ID=

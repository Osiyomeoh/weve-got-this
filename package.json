{
  "name": "carecircle-mcp",
  "version": "0.1.0",
  "description": "An open-source MCP server for shared household care coordination. Events -> Obligations -> Ownership.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/http.ts",
    "start": "node dist/http.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "tsx --env-file-if-exists=.env src/sim/app.ts",
    "demo": "npm run build && node --env-file-if-exists=.env dist/http.js",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts",
    "story": "tsx --env-file-if-exists=.env scripts/story.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo-reset.ts",
    "evals": "tsx --env-file-if-exists=.env scripts/evals.ts",
    "evals:massive": "tsx --env-file-if-exists=.env scripts/evals-massive.ts",
    "evals:languages": "tsx --env-file-if-exists=.env scripts/evals-languages.ts",
    "gate:compare": "tsx --env-file-if-exists=.env scripts/gate-compare.ts",
    "dynamo:check": "tsx --env-file-if-exists=.env scripts/dynamo-check.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "trust-benchmark": "tsx --env-file-if-exists=.env scripts/trust-benchmark.ts",
    "ring:simulate": "tsx --env-file-if-exists=.env src/demo/ring-simulate.ts",
    "beat": "tsx --env-file-if-exists=.env scripts/beat.ts",
    "trust-distribution": "tsx --env-file-if-exists=.env scripts/trust-distribution.ts",
    "google:auth": "tsx --env-file-if-exists=.env scripts/google-auth.ts",
    "calendar:sync": "tsx --env-file-if-exists=.env scripts/calendar-sync.ts",
    "calendar:push": "tsx --env-file-if-exists=.env scripts/calendar-push.ts",
    "email:sync": "tsx --env-file-if-exists=.env scripts/email-sync.ts",
    "ring:check": "tsx --env-file-if-exists=.env scripts/ring-check.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "telegram:ids": "tsx --env-file-if-exists=.env scripts/telegram-ids.ts",
    "telegram:webhook": "tsx --env-file-if-exists=.env scripts/telegram-webhook.ts",
    "telegram:invites": "tsx --env-file-if-exists=.env scripts/telegram-invites.ts",
    "demo:reset:prod": "tsx scripts/demo-reset-prod.ts",
    "pilot:report": "tsx --env-file-if-exists=.env scripts/pilot-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1131.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1132.0",
    "@aws-sdk/client-polly": "^3.1135.0",
    "@aws-sdk/client-service-quotas": "^3.1132.0",
    "@aws-sdk/client-sns": "^3.1133.0",
    "@aws-sdk/client-transcribe": "^3.1135.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.1132.0",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.1.0",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "fast-check": "^4.10.1",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  }
}
